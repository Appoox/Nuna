# Settings for running the project on your own machine.
#
# Copy this file to ".env" and adjust the values. ".env" is listed in
# .gitignore and must never be committed: it will hold real secrets.

# --- Django ---------------------------------------------------------------

# Signs sessions and tokens. Fine as-is for development; production needs a
# long random value that is kept private.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

# Detailed error pages. true for development, false in production.
DJANGO_DEBUG=true

# Host names the site may be served under, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins trusted for form posts over HTTPS, comma-separated
# (for example https://example.org). Leave empty for development.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL -----------------------------------------------------------

# Used twice: the database container creates this database and user on its
# first start, and Django connects with the same values.
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker-dev-password

# --- Wagtail --------------------------------------------------------------

# Name shown in the Wagtail admin. A placeholder until the site has a name.
WAGTAIL_SITE_NAME="Fact tracker"

# Full address of the site, used in links Wagtail emails to editors.
WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Stored files ---------------------------------------------------------

# Largest file that may be uploaded as a stored copy of a source, in
# megabytes. Bigger uploads are refused in the admin.
STORED_FILE_MAX_MB=500

# --- Docker Compose -------------------------------------------------------

# Port on your machine that shows the site. Change it if 8000 is taken.
WEB_PORT=8000
